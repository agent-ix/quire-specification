{
  "description": "Apply each replacement independently to the selected positive fixture; semantic outcomes require B's strict reader.",
  "roleSubstitutions": {
    "base": "roles.json",
    "replaceKindWith": [
      "trace",
      "fault-model",
      "review-procedure",
      "oracle",
      "observation",
      "review-disposition",
      "generated-artifact"
    ],
    "excludeSameKind": true,
    "expectedStructure": "valid",
    "expectedRoleMatch": "identity-mismatch"
  },
  "structuralMutations": [
    {
      "base": "semantic.json",
      "pointer": "/wireVersion",
      "replacement": "ix.shared-reference/unknown",
      "expected": "unsupported-version"
    },
    {
      "base": "semantic.json",
      "pointer": "/value/artifact/refVersion",
      "replacement": "ix.artifact-ref/2-draft",
      "expected": "unsupported-version"
    },
    {
      "base": "semantic.json",
      "pointer": "/value/artifact/kind",
      "replacement": "unknown-role",
      "expected": "invalid-wire"
    },
    {
      "base": "semantic.json",
      "pointer": "/value/canonicalIdentity/domain",
      "replacement": "unselected.jcs",
      "expected": "unsupported-canonicalization"
    },
    {
      "base": "semantic.json",
      "pointer": "/value/canonicalIdentity/version",
      "replacement": "rfc8785-v2",
      "expected": "unsupported-canonicalization"
    },
    {
      "base": "semantic.json",
      "pointer": "/value/canonicalIdentity/algorithm",
      "replacement": "sha512",
      "expected": "unsupported-canonicalization"
    },
    {
      "base": "semantic.json",
      "pointer": "/value/requiredFeatures",
      "replacement": [
        "a",
        "a"
      ],
      "expected": "invalid-wire"
    }
  ],
  "semanticMutations": [
    {
      "base": "semantic.json",
      "pointer": "/value/requiredFeatures",
      "replacement": [
        "unknown-required-feature"
      ],
      "expectedStructure": "valid",
      "expected": "unknown-required-feature"
    }
  ],
  "exactReferenceMutations": {
    "roles": [
      "property",
      "source",
      "binding",
      "dependency-closure",
      "run-artifact"
    ],
    "subjectRole": "source",
    "pointers": [
      "/authority",
      "/identity",
      "/wire/identity",
      "/wire/version"
    ],
    "expected": "identity-mismatch",
    "note": "Use a distinct valid replacement value on one axis; source is this byte-only subject fixture's explicit role, not a normative role for every semantic subject."
  },
  "coreCorrespondence": {
    "note": "Computed at test time, never stored: the test derives the core's JCS identity from core.json and compares it with the identity derived from a changed core, a wrapper including the disposition, and a different canonical domain. Each must differ.",
    "expected": "identity-mismatch"
  }
}
