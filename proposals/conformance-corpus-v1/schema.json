{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quire:conformance-corpus:v1",
  "title": "Quire complete-V1 conformance corpus",
  "description": "FR-336: closed transport structure for independently authored complete-V1 qualification vectors.",
  "type": "object",
  "required": [
    "contract_version",
    "vectors",
    "results",
    "coverage"
  ],
  "properties": {
    "contract_version": {
      "const": "quire.conformance-corpus/v1"
    },
    "vectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Vector"
      }
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Result"
      }
    },
    "coverage": {
      "$ref": "#/$defs/Coverage"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Nonempty": {
      "type": "string",
      "minLength": 1
    },
    "InputValue": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "boolean"
            },
            "value": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "decimal"
          ],
          "properties": {
            "kind": {
              "const": "integer"
            },
            "decimal": {
              "type": "string",
              "pattern": "^(0|-?[1-9][0-9]*)$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "universe",
            "type",
            "object_identity"
          ],
          "properties": {
            "kind": {
              "const": "reference"
            },
            "universe": {
              "$ref": "#/$defs/NodeId"
            },
            "type": {
              "$ref": "#/$defs/NodeId"
            },
            "object_identity": {
              "$ref": "#/$defs/Nonempty"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "name"
          ],
          "properties": {
            "kind": {
              "const": "population"
            },
            "name": {
              "$ref": "#/$defs/Nonempty"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "CallInput": {
      "type": "object",
      "required": [
        "function",
        "arguments",
        "accounting"
      ],
      "properties": {
        "function": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
        },
        "arguments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InputValue"
          }
        },
        "accounting": {
          "type": "object",
          "properties": {
            "work_units": {
              "$ref": "#/$defs/CanonicalUnsignedDecimal"
            },
            "result_units": {
              "$ref": "#/$defs/CanonicalUnsignedDecimal"
            },
            "integer_bits": {
              "$ref": "#/$defs/CanonicalUnsignedDecimal"
            },
            "decimal_digits": {
              "$ref": "#/$defs/CanonicalUnsignedDecimal"
            },
            "scale_expansion": {
              "$ref": "#/$defs/CanonicalUnsignedDecimal"
            },
            "text_input_bytes": {
              "$ref": "#/$defs/CanonicalUnsignedDecimal"
            },
            "text_scalars": {
              "$ref": "#/$defs/CanonicalUnsignedDecimal"
            },
            "normalized_scalars": {
              "$ref": "#/$defs/CanonicalUnsignedDecimal"
            },
            "unit_edges": {
              "$ref": "#/$defs/CanonicalUnsignedDecimal"
            },
            "value_occurrences": {
              "$ref": "#/$defs/CanonicalUnsignedDecimal"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "ReplayProvisionPath": {
      "type": "object",
      "required": [
        "authority",
        "identity",
        "bytes_path"
      ],
      "properties": {
        "authority": {
          "$ref": "#/$defs/Nonempty"
        },
        "identity": {
          "$ref": "#/$defs/Nonempty"
        },
        "bytes_path": {
          "$ref": "#/$defs/Nonempty"
        }
      },
      "additionalProperties": false
    },
    "CanonicalUnsignedDecimal": {
      "type": "string",
      "maxLength": 20,
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "ConsumerType": {
      "enum": [
        "language",
        "runtime",
        "monitor",
        "analyzer/backend",
        "tool",
        "consuming-system"
      ]
    },
    "ConsumerTypes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/ConsumerType"
      }
    },
    "CapabilityApplicability": {
      "type": "object",
      "required": [
        "consumer_types",
        "semantic_profiles"
      ],
      "properties": {
        "consumer_types": {
          "$ref": "#/$defs/ConsumerTypes"
        },
        "semantic_profiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Nonempty"
          }
        }
      },
      "additionalProperties": false
    },
    "VectorApplicability": {
      "type": "object",
      "required": [
        "consumer_types"
      ],
      "properties": {
        "consumer_types": {
          "$ref": "#/$defs/ConsumerTypes"
        }
      },
      "additionalProperties": false
    },
    "Capability": {
      "type": "object",
      "required": [
        "capability_id",
        "applicability"
      ],
      "properties": {
        "capability_id": {
          "$ref": "#/$defs/Nonempty"
        },
        "applicability": {
          "$ref": "#/$defs/CapabilityApplicability"
        }
      },
      "additionalProperties": false
    },
    "Coverage": {
      "type": "object",
      "required": [
        "primary",
        "criteria_rollups",
        "consumer_rollups"
      ],
      "properties": {
        "primary": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Capability"
          }
        },
        "criteria_rollups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CriterionRollup"
          }
        },
        "consumer_rollups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConsumerRollup"
          }
        }
      },
      "additionalProperties": false
    },
    "CriterionRollup": {
      "type": "object",
      "required": [
        "criterion_id",
        "capability_ids"
      ],
      "properties": {
        "criterion_id": {
          "$ref": "#/$defs/Nonempty"
        },
        "capability_ids": {
          "$ref": "#/$defs/NonemptyStringSet"
        }
      },
      "additionalProperties": false
    },
    "ConsumerRollup": {
      "type": "object",
      "required": [
        "consumer_type",
        "capability_ids"
      ],
      "properties": {
        "consumer_type": {
          "$ref": "#/$defs/ConsumerType"
        },
        "capability_ids": {
          "$ref": "#/$defs/NonemptyStringSet"
        }
      },
      "additionalProperties": false
    },
    "NonemptyStringSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/Nonempty"
      }
    },
    "Vector": {
      "type": "object",
      "required": [
        "id",
        "capability_id",
        "class",
        "subject",
        "applicability",
        "input",
        "expected"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Nonempty"
        },
        "capability_id": {
          "$ref": "#/$defs/Nonempty"
        },
        "class": {
          "enum": [
            "positive",
            "lower-boundary",
            "upper-boundary",
            "just-outside",
            "refusal",
            "incomplete",
            "metamorphic"
          ]
        },
        "mutation_of": {
          "$ref": "#/$defs/Nonempty"
        },
        "subject": {
          "$ref": "#/$defs/Subject"
        },
        "applicability": {
          "$ref": "#/$defs/VectorApplicability"
        },
        "input": {
          "$ref": "#/$defs/Input"
        },
        "expected": {
          "$ref": "#/$defs/ExpectedDisposition"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "class": {
                "const": "metamorphic"
              }
            },
            "required": [
              "class"
            ]
          },
          "then": {
            "required": [
              "mutation_of"
            ]
          },
          "else": {
            "not": {
              "required": [
                "mutation_of"
              ]
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "Subject": {
      "type": "object",
      "required": [
        "consumer_type",
        "operation"
      ],
      "properties": {
        "consumer_type": {
          "$ref": "#/$defs/ConsumerType"
        },
        "operation": {
          "$ref": "#/$defs/Nonempty"
        }
      },
      "additionalProperties": false
    },
    "Input": {
      "type": "object",
      "required": [
        "files"
      ],
      "properties": {
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/InputFile"
          }
        }
      },
      "additionalProperties": false
    },
    "InputFile": {
      "type": "object",
      "required": [
        "kind",
        "path"
      ],
      "properties": {
        "kind": {
          "enum": [
            "source",
            "model",
            "input",
            "call",
            "object-context",
            "population",
            "replay-request",
            "bytes"
          ]
        },
        "path": {
          "$ref": "#/$defs/Nonempty"
        }
      },
      "additionalProperties": false
    },
    "ExpectedDisposition": {
      "oneOf": [
        {
          "$ref": "#/$defs/ValueDisposition"
        },
        {
          "$ref": "#/$defs/RefusalDisposition"
        }
      ]
    },
    "ValueDisposition": {
      "type": "object",
      "required": [
        "disposition",
        "value"
      ],
      "properties": {
        "disposition": {
          "const": "value"
        },
        "value": {
          "description": "The JSON serialization of the subject operation's typed result; its type is defined by that operation."
        }
      },
      "additionalProperties": false
    },
    "RefusalDisposition": {
      "type": "object",
      "required": [
        "disposition",
        "code",
        "cause"
      ],
      "properties": {
        "disposition": {
          "const": "refusal"
        },
        "code": {
          "$ref": "#/$defs/Nonempty"
        },
        "cause": {
          "$ref": "#/$defs/Nonempty"
        },
        "details": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "Result": {
      "type": "object",
      "required": [
        "subject",
        "run_id",
        "vector_id",
        "outcome",
        "artifacts"
      ],
      "properties": {
        "subject": {
          "$ref": "#/$defs/Subject"
        },
        "run_id": {
          "$ref": "#/$defs/Nonempty"
        },
        "vector_id": {
          "$ref": "#/$defs/Nonempty"
        },
        "outcome": {
          "enum": [
            "passed",
            "failed",
            "unsupported",
            "unexecuted"
          ]
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Nonempty"
          }
        }
      },
      "additionalProperties": false
    },
    "UnsignedDecimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "SignedDecimal": {
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]*)$"
    },
    "ProfileSelection": {
      "type": "object",
      "required": [
        "profile",
        "value"
      ],
      "properties": {
        "profile": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "DependencyEntry": {
      "type": "object",
      "required": [
        "identity",
        "sources"
      ],
      "properties": {
        "identity": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          }
        },
        "refinement_internals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "urn:quire:checked-package:v2#/$defs/RefinementInternal"
          }
        }
      },
      "additionalProperties": false
    },
    "ScalarLimits": {
      "type": "object",
      "required": [
        "integer_bits",
        "decimal_digits",
        "scale_expansion",
        "text_input_bytes",
        "text_scalars",
        "normalized_scalars",
        "unit_edges",
        "value_occurrences",
        "work_units",
        "result_units"
      ],
      "properties": {
        "integer_bits": {
          "$ref": "#/$defs/UnsignedDecimal"
        },
        "decimal_digits": {
          "$ref": "#/$defs/UnsignedDecimal"
        },
        "scale_expansion": {
          "$ref": "#/$defs/UnsignedDecimal"
        },
        "text_input_bytes": {
          "$ref": "#/$defs/UnsignedDecimal"
        },
        "text_scalars": {
          "$ref": "#/$defs/UnsignedDecimal"
        },
        "normalized_scalars": {
          "$ref": "#/$defs/UnsignedDecimal"
        },
        "unit_edges": {
          "$ref": "#/$defs/UnsignedDecimal"
        },
        "value_occurrences": {
          "$ref": "#/$defs/UnsignedDecimal"
        },
        "work_units": {
          "$ref": "#/$defs/UnsignedDecimal"
        },
        "result_units": {
          "$ref": "#/$defs/UnsignedDecimal"
        }
      },
      "additionalProperties": false
    },
    "OccurrenceKey": {
      "type": "object",
      "required": [
        "node_id",
        "role",
        "ordinal"
      ],
      "properties": {
        "node_id": {
          "$ref": "#/$defs/NodeId"
        },
        "role": {
          "type": "string"
        },
        "ordinal": {
          "$ref": "#/$defs/UnsignedDecimal"
        }
      },
      "additionalProperties": false
    },
    "ReplayOverBinding": {
      "type": "object",
      "required": [
        "population",
        "key"
      ],
      "properties": {
        "population": {
          "type": "string"
        },
        "key": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ReplayTargetMembers": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "function"
          ],
          "properties": {
            "function": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "frame_operation"
          ],
          "properties": {
            "frame_operation": {
              "type": "object",
              "required": [
                "object",
                "operation"
              ],
              "properties": {
                "object": {
                  "type": "string",
                  "minLength": 1
                },
                "operation": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "state_clause"
          ],
          "properties": {
            "state_clause": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "RequestTargetWire": {
      "type": "object",
      "required": [
        "members",
        "arguments",
        "occurrence_key",
        "over"
      ],
      "properties": {
        "members": {
          "$ref": "#/$defs/ReplayTargetMembers"
        },
        "arguments": {
          "type": "boolean"
        },
        "occurrence_key": {
          "oneOf": [
            {
              "$ref": "#/$defs/OccurrenceKey"
            },
            {
              "type": "null"
            }
          ]
        },
        "over": {
          "oneOf": [
            {
              "$ref": "#/$defs/ReplayOverBinding"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "CanonicalAssignment": {
      "type": "object",
      "required": [
        "parameter",
        "value"
      ],
      "properties": {
        "parameter": {
          "$ref": "#/$defs/NodeId"
        },
        "value": {
          "$ref": "#/$defs/WitnessValue"
        }
      },
      "additionalProperties": false
    },
    "ReplaySource": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "transcript"
          ],
          "properties": {
            "kind": {
              "const": "witness"
            },
            "transcript": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "assignments"
          ],
          "properties": {
            "kind": {
              "const": "input"
            },
            "assignments": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/CanonicalAssignment"
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "DomainKey": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "node",
            "path"
          ],
          "properties": {
            "kind": {
              "const": "node"
            },
            "node": {
              "$ref": "#/$defs/NodeId"
            },
            "path": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/UnsignedDecimal"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "member_type",
            "ordinal"
          ],
          "properties": {
            "kind": {
              "const": "population"
            },
            "member_type": {
              "$ref": "#/$defs/NodeId"
            },
            "ordinal": {
              "$ref": "#/$defs/UnsignedDecimal"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "DomainKind": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "collection"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "population"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "integer"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "recursive"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "loop"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "infinite_trace"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "quantity"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "FiniteBound": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "maximum"
          ],
          "properties": {
            "kind": {
              "const": "cardinality"
            },
            "maximum": {
              "$ref": "#/$defs/UnsignedDecimal"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "lower",
            "upper"
          ],
          "properties": {
            "kind": {
              "const": "integer_range"
            },
            "lower": {
              "$ref": "#/$defs/SignedDecimal"
            },
            "upper": {
              "$ref": "#/$defs/SignedDecimal"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "maximum"
          ],
          "properties": {
            "kind": {
              "const": "depth"
            },
            "maximum": {
              "$ref": "#/$defs/UnsignedDecimal"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "members"
          ],
          "properties": {
            "kind": {
              "const": "variants"
            },
            "members": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "DeclaredDomain": {
      "type": "object",
      "required": [
        "domain",
        "kind",
        "bound"
      ],
      "properties": {
        "domain": {
          "$ref": "#/$defs/DomainKey"
        },
        "kind": {
          "oneOf": [
            {
              "$ref": "#/$defs/DomainKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "bound": {
          "$ref": "#/$defs/FiniteBound"
        }
      },
      "additionalProperties": false
    },
    "ObjectEnvironmentRef": {
      "type": "object",
      "required": [
        "identity"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/SourceRef"
        }
      },
      "additionalProperties": false
    },
    "SuppliedLimits": {
      "type": "object",
      "required": [
        "admission_work_units",
        "conversion_work_units",
        "numeric_magnitude_bits"
      ],
      "properties": {
        "admission_work_units": {
          "$ref": "#/$defs/UnsignedDecimal"
        },
        "conversion_work_units": {
          "$ref": "#/$defs/UnsignedDecimal"
        },
        "numeric_magnitude_bits": {
          "$ref": "#/$defs/UnsignedDecimal"
        }
      },
      "additionalProperties": false
    },
    "StateEnvironment": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "string"
