    {
      "id": "NI-12",
      "criterion": "FR-322-AC-280",
      "patch": [
        {
          "op": "add",
          "path": "/semantic_graph/nodes/0/node_id/path/2",
          "value": {
            "node": 2
          }
        }
      ],
      "schema": "valid",
      "expected": "malformed_wire",
      "locus": "/semantic_graph/nodes/0/node_id/path/2/node",
      "note": "nodes 0 and 2 name each other; node 0's segment is the first by graph index"
    }
  ]
}
