{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quire:business-meanings-k2:v1",
  "title": "FR-208 business-meaning admission fixture (K2) and its refusal vocabulary vectors",
  "type": "object",
  "required": ["version", "package", "nodes", "vectors"],
  "properties": {
    "version": {"const": "quire.checked-package-v2.business-meanings-k2/v1"},
    "package": {"$ref": "#/$defs/PackageRef"},
    "nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/Node"}},
    "vectors": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/Vector"}}
  },
  "additionalProperties": false,
  "$defs": {
    "Nonempty": {"type": "string", "minLength": 1},
    "NodeId": {"type": "string", "pattern": "^ix://test/orders/[A-Za-z][A-Za-z0-9]*(/[A-Za-z][A-Za-z0-9]*)?$"},
    "AcId": {"type": "string", "pattern": "^FR-208-AC-(4|5|6|7|8|9|10|11|12)$"},
    "RefusalCode": {"enum": ["invalid_model_binding", "unsupported_construct", "missing_declaration", "wrong_snapshot"]},
    "RefusalCause": {"type": "string", "pattern": "^[a-z][a-z-]*$"},
    "MemberPath": {"type": "string", "pattern": "^(TypeDefinition|Field|Operation|Relationship|Population)\\."},
    "PackageRef": {
      "type": "object",
      "required": ["identity", "version"],
      "properties": {"identity": {"const": "test/orders"}, "version": {"const": "1"}},
      "additionalProperties": false
    },
    "Meaning": {
      "enum": ["object-type", "value-type", "record-value-type", "event-type", "state-machine", "process", "persistence-interface", "namespace"]
    },
    "Field": {
      "type": "object",
      "required": ["name", "typeRef"],
      "properties": {"name": {"$ref": "#/$defs/Nonempty"}, "typeRef": {"$ref": "#/$defs/Nonempty"}},
      "additionalProperties": false
    },
    "Operation": {
      "type": "object",
      "required": ["name", "hasPrecondition"],
      "properties": {
        "name": {"$ref": "#/$defs/Nonempty"},
        "hasPrecondition": {"type": "boolean"},
        "hasPostcondition": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "Transition": {
      "type": "object",
      "required": ["from", "to", "trigger", "emits"],
      "properties": {
        "from": {"$ref": "#/$defs/Nonempty"},
        "to": {"$ref": "#/$defs/Nonempty"},
        "trigger": {"$ref": "#/$defs/Nonempty"},
        "guard": {"$ref": "#/$defs/Nonempty"},
        "emits": {"type": "array", "items": {"$ref": "#/$defs/Nonempty"}}
      },
      "additionalProperties": false
    },
    "Step": {
      "type": "object",
      "required": ["name", "consumes", "emits"],
      "properties": {
        "name": {"$ref": "#/$defs/Nonempty"},
        "consumes": {"type": "array", "items": {"$ref": "#/$defs/Nonempty"}},
        "emits": {"type": "array", "items": {"$ref": "#/$defs/Nonempty"}}
      },
      "additionalProperties": false
    },
    "Clause": {
      "type": "object",
      "required": ["name", "language", "role"],
      "properties": {
        "name": {"$ref": "#/$defs/Nonempty"},
        "language": {"$ref": "#/$defs/Nonempty"},
        "role": {"enum": ["invariant", "guard"]}
      },
      "additionalProperties": false
    },
    "Node": {
      "type": "object",
      "required": ["id", "meaning"],
      "properties": {
        "id": {"$ref": "#/$defs/NodeId"},
        "meaning": {"$ref": "#/$defs/Meaning"},
        "fields": {"type": "array", "items": {"$ref": "#/$defs/Field"}},
        "identityFields": {"type": "array", "items": {"$ref": "#/$defs/Nonempty"}},
        "occurrenceField": {"$ref": "#/$defs/Nonempty"},
        "operations": {"type": "array", "items": {"$ref": "#/$defs/Operation"}},
        "states": {"type": "array", "items": {"$ref": "#/$defs/Nonempty"}},
        "transitions": {"type": "array", "items": {"$ref": "#/$defs/Transition"}},
        "steps": {"type": "array", "items": {"$ref": "#/$defs/Step"}},
        "persists": {"type": "array", "items": {"$ref": "#/$defs/Nonempty"}},
        "members": {"type": "array", "items": {"$ref": "#/$defs/Nonempty"}},
        "supertypes": {"type": "array", "items": {"$ref": "#/$defs/Nonempty"}},
        "clauses": {"type": "array", "items": {"$ref": "#/$defs/Clause"}}
      },
      "additionalProperties": false
    },
    "AdmittedVector": {
      "type": "object",
      "required": ["id", "ac", "kind", "scenario"],
      "properties": {
        "id": {"$ref": "#/$defs/Nonempty"},
        "ac": {"$ref": "#/$defs/AcId"},
        "kind": {"const": "admitted"},
        "scenario": {"$ref": "#/$defs/Nonempty"},
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    },
    "RefusedVector": {
      "type": "object",
      "required": ["id", "ac", "kind", "scenario", "code", "cause", "node"],
      "properties": {
        "id": {"$ref": "#/$defs/Nonempty"},
        "ac": {"$ref": "#/$defs/AcId"},
        "kind": {"const": "refused"},
        "scenario": {"$ref": "#/$defs/Nonempty"},
        "code": {"$ref": "#/$defs/RefusalCode"},
        "cause": {"$ref": "#/$defs/RefusalCause"},
        "node": {"$ref": "#/$defs/NodeId"},
        "member_path": {"$ref": "#/$defs/MemberPath"},
        "absent_node": {"$ref": "#/$defs/NodeId"},
        "conflict_with": {"$ref": "#/$defs/MemberPath"},
        "cycle": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/NodeId"}},
        "required_context": {"$ref": "#/$defs/Nonempty"},
        "actual_context": {"$ref": "#/$defs/Nonempty"}
      },
      "additionalProperties": false
    },
    "Vector": {"oneOf": [{"$ref": "#/$defs/AdmittedVector"}, {"$ref": "#/$defs/RefusedVector"}]}
  }
}
