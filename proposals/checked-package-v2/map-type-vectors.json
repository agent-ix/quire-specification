        {"identity":"ix://acme/maps/ClockRef","kind":"reference","target":"ix://quire/native/Clock"},
        {"identity":"ix://acme/maps/Holder","kind":"object","fields":[{"name":"m","typeRef":"ix://acme/maps/M"}]},
        {"identity":"ix://acme/maps/M","kind":"map","keys":"ix://quire/native/Text","values":"ix://acme/maps/Timer","bound":{"lower":0,"upper":2}}
