{
  "version": "quire.clock-presence-frame-vectors/v1",
  "rule": "FR-415-AC-21: an Option<Clock> place is live only when its presence bit is present; an unwritten bit does not change, a requirement is a constraint and never a write, and there is no implicit reset to 0. A presence requirement that nothing writes has no successor and refuses invalid_timed_model/clock-presence-unwritten when the precondition establishes absence.",
  "places": {
    "option": "v: Option<Clock>"
  },
  "pre_state": "option: {present, clock}",
  "write": "option: {clock: c} makes the place present with c, {absent: true} drops it; null writes nothing",
  "successor": "a list of {present, clock}; an empty list is no successor; {refused} is the static refusal",
  "cases": [
    {
      "id": "FP-01",
      "form": "option",
      "pre": {
        "present": false,
        "clock": null
      },
      "requires": "present(self.v)",
      "write": null,
      "expected": []
    },
    {
      "id": "FP-03",
      "form": "option",
      "pre": {
        "present": false,
        "clock": null
      },
      "requires": "present(self.v)",
      "write": {
        "clock": "5 ms"
      },
      "expected": [
        {
          "present": true,
          "clock": "5 ms"
        }
      ]
    },
    {
      "id": "FP-05",
      "form": "option",
      "pre": {
        "present": true,
        "clock": "3 ms"
      },
      "requires": null,
      "write": null,
      "expected": [
        {
          "present": true,
          "clock": "3 ms"
        }
      ]
    },
    {
      "id": "FP-07",
      "form": "option",
      "pre": {
        "present": true,
        "clock": "3 ms"
      },
      "requires": null,
      "write": {
        "absent": true
      },
      "expected": [
        {
          "present": false,
          "clock": null
        }
      ]
    },
    {
      "id": "FP-09",
      "form": "option",
      "pre": {
        "present": true,
        "clock": "3 ms"
      },
      "requires": "present(self.v)",
      "write": null,
      "expected": [
        {
          "present": true,
          "clock": "3 ms"
        }
      ]
    },
    {
      "id": "FP-11",
      "form": "option",
      "pre": {
        "present": false,
        "clock": null
      },
      "requires": "present(self.v)",
      "write": null,
      "precondition_establishes_absent": true,
      "expected": {
        "refused": {
          "code": "invalid_timed_model",
          "cause": "clock-presence-unwritten"
        }
      }
    },
    {
      "id": "FP-13",
      "form": "option",
      "pre": {
        "present": true,
        "clock": "3 ms"
      },
      "requires": "not present(self.v)",
      "write": null,
      "expected": []
    }
  ]
}
