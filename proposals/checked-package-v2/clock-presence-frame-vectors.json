{
  "version": "quire.clock-presence-frame-vectors/v1",
  "rule": "FR-415-AC-21: a place becomes present only by a write of its clock value, for an Option<Clock> place and a union case alike. An unwritten place keeps its presence and its clock; a presence requirement that is not met by the written or kept state has no successor. There is no implicit reset to 0.",
  "places": {
    "option": "v: Option<Clock>",
    "union": "st: Mode, Mode = Idle | Armed { x: Clock }; the place is st.Armed.x"
  },
  "pre_state": "option: {present, clock}; union: {case, clock} with clock null in Idle",
  "write": "option: {clock: c} makes the place present with c, {absent: true} drops it; union: {constructor: Armed, clock: c} makes it present with c, {constructor: Idle} drops it; null writes nothing",
  "successor": "{present, clock}; an empty list is no successor",
  "cases": [
    {
      "id": "FP-01",
      "form": "option",
      "pre": {
        "present": false,
        "clock": null
      },
      "requires": "present(self.v)",
      "write": null,
      "expected": [],
      "equivalent_to": "FP-02"
    },
    {
      "id": "FP-02",
      "form": "union",
      "pre": {
        "case": "Idle",
        "clock": null
      },
      "requires": "present(self.st.Armed)",
      "write": null,
      "expected": [],
      "equivalent_to": "FP-01"
    },
    {
      "id": "FP-03",
      "form": "option",
      "pre": {
        "present": false,
        "clock": null
      },
      "requires": "present(self.v)",
      "write": {
        "clock": "5 ms"
      },
      "expected": [
        {
          "present": true,
          "clock": "5 ms"
        }
      ],
      "equivalent_to": "FP-04"
    },
    {
      "id": "FP-04",
      "form": "union",
      "pre": {
        "case": "Idle",
        "clock": null
      },
      "requires": "present(self.st.Armed)",
      "write": {
        "constructor": "Armed",
        "clock": "5 ms"
      },
      "expected": [
        {
          "present": true,
          "clock": "5 ms"
        }
      ],
      "equivalent_to": "FP-03"
    },
    {
      "id": "FP-05",
      "form": "option",
      "pre": {
        "present": true,
        "clock": "3 ms"
      },
      "requires": null,
      "write": null,
      "expected": [
        {
          "present": true,
          "clock": "3 ms"
        }
      ],
      "equivalent_to": "FP-06"
    },
    {
      "id": "FP-06",
      "form": "union",
      "pre": {
        "case": "Armed",
        "clock": "3 ms"
      },
      "requires": null,
      "write": null,
      "expected": [
        {
          "present": true,
          "clock": "3 ms"
        }
      ],
      "equivalent_to": "FP-05"
    },
    {
      "id": "FP-07",
      "form": "option",
      "pre": {
        "present": true,
        "clock": "3 ms"
      },
      "requires": null,
      "write": {
        "absent": true
      },
      "expected": [
        {
          "present": false,
          "clock": null
        }
      ],
      "equivalent_to": "FP-08"
    },
    {
      "id": "FP-08",
      "form": "union",
      "pre": {
        "case": "Armed",
        "clock": "3 ms"
      },
      "requires": null,
      "write": {
        "constructor": "Idle"
      },
      "expected": [
        {
          "present": false,
          "clock": null
        }
      ],
      "equivalent_to": "FP-07"
    },
    {
      "id": "FP-09",
      "form": "option",
      "pre": {
        "present": true,
        "clock": "3 ms"
      },
      "requires": "present(self.v)",
      "write": null,
      "expected": [
        {
          "present": true,
          "clock": "3 ms"
        }
      ],
      "equivalent_to": "FP-10"
    },
    {
      "id": "FP-10",
      "form": "union",
      "pre": {
        "case": "Armed",
        "clock": "3 ms"
      },
      "requires": "present(self.st.Armed)",
      "write": null,
      "expected": [
        {
          "present": true,
          "clock": "3 ms"
        }
      ],
      "equivalent_to": "FP-09"
    }
  ]
}
