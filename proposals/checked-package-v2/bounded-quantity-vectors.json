{
  "version": 1,
  "note": "QSL-1742 / FR-322: lossless checked-package form for FR-154 Quantity<u>[min,max]. Bounds are inclusive exact magnitudes in the stated unit and are not projected through a rational numerator/denominator carrier. Each case records the reader-visible form and the expected admission or refusal.",
  "forms": [
    {
      "id": "BQ-01",
      "description": "Quantity<m>[-3/2,7/4]",
      "unit": "m",
      "min": {
        "kind": "rational",
        "numerator": "-3",
        "denominator": "2"
      },
      "max": {
        "kind": "rational",
        "numerator": "7",
        "denominator": "4"
      },
      "path": [
        "scalar_type",
        "bounded_quantity",
        "<m-node>",
        "min",
        "<rational-node>",
        "-3/2",
        "max",
        "<rational-node>",
        "7/4"
      ],
      "expected": "admitted"
    },
    {
      "id": "BQ-02",
      "description": "same bounds, different unit",
      "unit": "cm",
      "min": {
        "kind": "rational",
        "numerator": "-3",
        "denominator": "2"
      },
      "max": {
        "kind": "rational",
        "numerator": "7",
        "denominator": "4"
      },
      "expected": "distinct-node"
    },
    {
      "id": "BQ-03",
      "description": "same unit and bounds through an alias",
      "unit": "m",
      "min": {
        "kind": "rational",
        "numerator": "-3",
        "denominator": "2"
      },
      "max": {
        "kind": "rational",
        "numerator": "7",
        "denominator": "4"
      },
      "expected": "same-node"
    },
    {
      "id": "BQ-04",
      "description": "integer exact bounds",
      "unit": "m",
      "min": {
        "kind": "integer",
        "decimal": "0"
      },
      "max": {
        "kind": "integer",
        "decimal": "20"
      },
      "expected": "admitted"
    },
    {
      "id": "BQ-05",
      "description": "reversed bounds",
      "unit": "m",
      "min": {
        "kind": "integer",
        "decimal": "8"
      },
      "max": {
        "kind": "integer",
        "decimal": "7"
      },
      "expected": {
        "code": "invalid_package",
        "cause": "invalid-derived-shape",
        "pointer": "/semantic_graph/nodes/{n}"
      }
    },
    {
      "id": "BQ-06",
      "description": "unreduced rational endpoint 2/4",
      "unit": "m",
      "min": {
        "kind": "rational",
        "numerator": "2",
        "denominator": "4"
      },
      "max": {
        "kind": "integer",
        "decimal": "1"
      },
      "expected": {
        "code": "invalid_package",
        "cause": "invalid-derived-shape",
        "pointer": "/semantic_graph/nodes/{n}/body/members/1/value"
      }
    },
    {
      "id": "BQ-07",
      "description": "bare unit or compound unit used as a bounded parameter without Quantity bounds",
      "expected": {
        "code": "ill_typed",
        "cause": "requires-bound"
      }
    },
    {
      "id": "BQ-08",
      "description": "add, convert and lt each accept an operand/result typed by the bounded quantity form when existing dimensional and exact-conversion rules hold",
      "operations": [
        "quire.op.quantity.add",
        "quire.op.quantity.convert",
        "quire.op.quantity.lt"
      ],
      "expected": "admitted"
    },
    {
      "id": "BQ-09",
      "description": "quantity.convert result outside the inclusive target bounds",
      "operation": "quire.op.quantity.convert",
      "expected": {
        "code": "rational_out_of_domain",
        "pointer": "/semantic_graph/nodes/{n}/body/result_type"
      }
    },
    {
      "id": "BQ-10",
      "description": "quantity.lt operands with dimensionally incompatible units",
      "operation": "quire.op.quantity.lt",
      "expected": {
        "code": "ill_typed",
        "cause": "operator-ineligible"
      }
    }
  ]
}
