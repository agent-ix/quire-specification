{
  "version": 1,
  "note": "FR-322-AC-304 (TC-233 DL-07..DL-10): text literals typed by a text_bounds node. `types` name Text[min, max; profile]; `value` is the retained sequence the reader receives and never normalizes; `normalized` records whether it equals its own normalization under the profile; `length` is the scalar count, or the UTF-8 byte count under binary-utf8. The refusal locus is the literal's `value` member, `pointer` with `{n}` the node index for a root literal. QSpec's test recomputes lengths and checks the expectation against the stated rule, taking `normalized` as authored (QSpec holds no normalization tables); the reader that decides these outcomes is quire-contract-ir's (FR-038).",
  "types": {
    "nfc23": {
      "min": 2,
      "max": 3,
      "text_profile": "nfc"
    },
    "nfd12": {
      "min": 1,
      "max": 2,
      "text_profile": "nfd"
    },
    "scalars13": {
      "min": 1,
      "max": 3,
      "text_profile": "unicode-scalars"
    },
    "bin13": {
      "min": 1,
      "max": 3,
      "text_profile": "binary-utf8"
    }
  },
  "cases": [
    {
      "id": "TX-01",
      "type": "nfc23",
      "value": "ab",
      "normalized": true,
      "length": 2,
      "expected": "admitted",
      "note": "exact minimum"
    },
    {
      "id": "TX-02",
      "type": "nfc23",
      "value": "abc",
      "normalized": true,
      "length": 3,
      "expected": "admitted",
      "note": "exact maximum"
    },
    {
      "id": "TX-03",
      "type": "nfc23",
      "value": "a",
      "normalized": true,
      "length": 1,
      "expected": "refused",
      "code": "ill_typed",
      "cause": "type-mismatch",
      "pointer": "/semantic_graph/nodes/{n}/body/value",
      "reason": "below-min",
      "note": "one below the minimum"
    },
    {
      "id": "TX-04",
      "type": "nfc23",
      "value": "abcd",
      "normalized": true,
      "length": 4,
      "expected": "refused",
      "code": "ill_typed",
      "cause": "type-mismatch",
      "pointer": "/semantic_graph/nodes/{n}/body/value",
      "reason": "above-max",
      "note": "one above the maximum"
    },
    {
      "id": "TX-05",
      "type": "nfc23",
      "value": "\u00e9b",
      "normalized": true,
      "length": 2,
