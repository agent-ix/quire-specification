{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quire:checked-semantic-node-preimage:v1",
  "title": "Complete-V1 admitted nominal and expression-application semantic node identity preimages",
  "oneOf": [
    {"$ref": "#/$defs/EnumDeclaration"},
    {"$ref": "#/$defs/EnumMember"},
    {"$ref": "#/$defs/Dimension"},
    {"$ref": "#/$defs/Unit"},
    {"$ref": "#/$defs/ExpressionApplication"}
  ],
  "$defs": {
    "Nonempty": {"type": "string", "minLength": 1},
    "HexDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "Identifier": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
    "QualifiedName": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/Identifier"}},
    "SourceOwner": {"type": "object", "required": ["kind", "authority", "identity"], "properties": {"kind": {"const": "source"}, "authority": {"$ref": "#/$defs/Nonempty"}, "identity": {"$ref": "#/$defs/Nonempty"}}, "additionalProperties": false},
    "DefinitionOwner": {"type": "object", "required": ["kind", "authority", "identity"], "properties": {"kind": {"const": "definition"}, "authority": {"$ref": "#/$defs/Nonempty"}, "identity": {"$ref": "#/$defs/Nonempty"}}, "additionalProperties": false},
    "ModelOwner": {"type": "object", "required": ["kind", "authority", "identity", "export"], "properties": {"kind": {"const": "model"}, "authority": {"$ref": "#/$defs/Nonempty"}, "identity": {"$ref": "#/$defs/Nonempty"}, "export": {"$ref": "#/$defs/Nonempty"}}, "additionalProperties": false},
    "Owner": {"oneOf": [{"$ref": "#/$defs/SourceOwner"}, {"$ref": "#/$defs/DefinitionOwner"}, {"$ref": "#/$defs/ModelOwner"}]},
    "NodeId": {"type": "object", "required": ["domain", "digest"], "properties": {"domain": {"const": "quire.checked-semantic-node/v1"}, "digest": {"$ref": "#/$defs/HexDigest"}}, "additionalProperties": false},
    "IntegerString": {"type": "string", "pattern": "^(0|-?[1-9][0-9]*)$"},
    "PositiveIntegerString": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "Rational": {"type": "object", "required": ["numerator", "denominator"], "properties": {"numerator": {"$ref": "#/$defs/IntegerString"}, "denominator": {"$ref": "#/$defs/PositiveIntegerString"}}, "additionalProperties": false},
    "DimensionTerm": {"type": "object", "required": ["dimension_node_id", "exponent"], "properties": {"dimension_node_id": {"$ref": "#/$defs/NodeId"}, "exponent": {"$ref": "#/$defs/IntegerString"}}, "additionalProperties": false},
    "Revision": {"type": "object", "required": ["namespace", "value"], "properties": {"namespace": {"$ref": "#/$defs/Nonempty"}, "value": {"$ref": "#/$defs/Nonempty"}}, "additionalProperties": false},
    "DefinitionRef": {"type": "object", "required": ["authority", "identity", "revision", "digest_domain", "digest"], "properties": {"authority": {"$ref": "#/$defs/Nonempty"}, "identity": {"$ref": "#/$defs/Nonempty"}, "revision": {"$ref": "#/$defs/Revision"}, "digest_domain": {"const": "quire.definition.bytes/v1"}, "digest": {"$ref": "#/$defs/HexDigest"}}, "additionalProperties": false},
    "NodeRef": {"$ref": "#/$defs/NodeId"},
    "OperationIdentity": {"enum": ["quire.op.boolean.not","quire.op.boolean.and","quire.op.boolean.or","quire.op.boolean.implies","quire.op.boolean.eq","quire.op.boolean.ne","quire.op.integer.negate","quire.op.integer.add","quire.op.integer.sub","quire.op.integer.mul","quire.op.integer.div","quire.op.integer.rem","quire.op.integer.mod","quire.op.integer.eq","quire.op.integer.ne","quire.op.integer.lt","quire.op.integer.le","quire.op.integer.gt","quire.op.integer.ge","quire.op.rational.negate","quire.op.rational.add","quire.op.rational.sub","quire.op.rational.mul","quire.op.rational.div","quire.op.rational.eq","quire.op.rational.ne","quire.op.rational.lt","quire.op.rational.le","quire.op.rational.gt","quire.op.rational.ge","quire.op.decimal.negate","quire.op.decimal.add","quire.op.decimal.sub","quire.op.decimal.mul","quire.op.decimal.div","quire.op.decimal.eq","quire.op.decimal.ne","quire.op.decimal.lt","quire.op.decimal.le","quire.op.decimal.gt","quire.op.decimal.ge","quire.op.quantity.add","quire.op.quantity.sub","quire.op.quantity.mul","quire.op.quantity.div","quire.op.quantity.pow","quire.op.quantity.eq","quire.op.quantity.ne","quire.op.quantity.lt","quire.op.quantity.le","quire.op.quantity.gt","quire.op.quantity.ge","quire.op.quantity.convert","quire.op.ieee.float32.negate","quire.op.ieee.float32.add","quire.op.ieee.float32.sub","quire.op.ieee.float32.mul","quire.op.ieee.float32.div","quire.op.ieee.float32.sqrt","quire.op.ieee.float32.fma","quire.op.ieee.float32.eq","quire.op.ieee.float32.ne","quire.op.ieee.float32.lt","quire.op.ieee.float32.le","quire.op.ieee.float32.gt","quire.op.ieee.float32.ge","quire.op.ieee.float32.numeric_equal","quire.op.ieee.float32.total_order","quire.op.ieee.float32.bit_identical","quire.op.ieee.float32.to_float64","quire.op.ieee.float32.to_rational","quire.op.ieee.float32.from_exact","quire.op.ieee.float64.negate","quire.op.ieee.float64.add","quire.op.ieee.float64.sub","quire.op.ieee.float64.mul","quire.op.ieee.float64.div","quire.op.ieee.float64.sqrt","quire.op.ieee.float64.fma","quire.op.ieee.float64.eq","quire.op.ieee.float64.ne","quire.op.ieee.float64.lt","quire.op.ieee.float64.le","quire.op.ieee.float64.gt","quire.op.ieee.float64.ge","quire.op.ieee.float64.numeric_equal","quire.op.ieee.float64.total_order","quire.op.ieee.float64.bit_identical","quire.op.ieee.float64.to_float32","quire.op.ieee.float64.to_rational","quire.op.ieee.float64.from_exact","quire.op.text.eq","quire.op.text.ne","quire.op.text.lt","quire.op.text.le","quire.op.text.gt","quire.op.text.ge","quire.op.text.size","quire.op.enum.eq","quire.op.enum.ne","quire.op.enum.lt","quire.op.enum.le","quire.op.enum.gt","quire.op.enum.ge","quire.op.structural.eq","quire.op.structural.ne","quire.op.reference.eq","quire.op.reference.ne","quire.op.numeric.convert","quire.op.reference.upcast","quire.op.option.present","quire.op.option.value","quire.op.state.pre","quire.op.control.if","quire.op.control.let","quire.op.collection.sequence","quire.op.collection.set","quire.op.collection.bag","quire.op.collection.ordered_set","quire.op.collection.map","quire.op.collection.filter","quire.op.collection.flat_map","quire.op.collection.flatten","quire.op.collection.fold","quire.op.collection.reduce","quire.op.collection.count","quire.op.collection.sum","quire.op.collection.size","quire.op.collection.contains","quire.op.collection.forall","quire.op.collection.exists","quire.op.collection.convert","quire.op.model.deref","quire.op.model.navigate","quire.op.model.reaches","quire.op.model.lookup.undefined","quire.op.model.lookup.empty","quire.op.model.lookup.refused","quire.op.model.all_instances","quire.op.model.dispatch_call","quire.op.function.call","quire.op.temporal.clause","quire.op.protocol.control","quire.op.state.transition","quire.op.claim.clause"]},
    "OperationLaw": {"type": "object", "required": ["role", "definition"], "properties": {"role": {"enum": ["integer_division", "ieee_profile", "text_profile"]}, "definition": {"$ref": "#/$defs/DefinitionRef"}}, "additionalProperties": false},
    "OperationMode": {"oneOf": [
      {"type": "null"},
      {"type": "object", "required": ["kind", "value"], "properties": {"kind": {"const": "rounding"}, "value": {"enum": ["exact", "toward-zero", "toward-positive", "toward-negative", "nearest-even", "nearest-away"]}}, "additionalProperties": false},
      {"type": "object", "required": ["kind", "value"], "properties": {"kind": {"const": "text_profile"}, "value": {"enum": ["unicode-scalars", "nfc", "nfd", "nfkc", "nfkd", "binary-utf8"]}}, "additionalProperties": false}
    ]},
    "Operation": {"type": "object", "required": ["identity", "laws", "mode"], "properties": {"identity": {"$ref": "#/$defs/OperationIdentity"}, "laws": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/OperationLaw"}}, "mode": {"$ref": "#/$defs/OperationMode"}}, "additionalProperties": false},
    "SemanticTerm": {"oneOf": [
      {"type": "object", "required": ["term", "value_kind", "value"], "properties": {"term": {"const": "literal"}, "value_kind": {"enum": ["boolean", "integer", "rational", "decimal", "float32_bits", "float64_bits", "text", "enum", "none"]}, "value": {"type": ["boolean", "string", "integer", "null"]}}, "additionalProperties": false},
      {"type": "object", "required": ["term", "target"], "properties": {"term": {"const": "reference"}, "target": {"$ref": "#/$defs/NodeRef"}}, "additionalProperties": false},
      {"type": "object", "required": ["term", "operator", "operation", "arguments"], "properties": {"term": {"const": "application"}, "operator": {"enum": ["call", "unary", "binary", "conditional", "let", "quantify", "collection", "query", "convert", "pre", "present", "value", "deref", "reaches", "temporal", "protocol_control", "state_transition", "claim"]}, "operation": {"$ref": "#/$defs/Operation"}, "arguments": {"type": "array", "items": {"$ref": "#/$defs/SemanticTerm"}}}, "additionalProperties": false},
      {"type": "object", "required": ["term", "members"], "properties": {"term": {"const": "aggregate"}, "members": {"type": "array", "items": {"$ref": "#/$defs/SemanticTerm"}}}, "additionalProperties": false},
      {"type": "object", "required": ["term", "name", "value"], "properties": {"term": {"const": "binding"}, "name": {"$ref": "#/$defs/Nonempty"}, "value": {"$ref": "#/$defs/SemanticTerm"}}, "additionalProperties": false}
    ]},
    "ApplicationTerm": {"type": "object", "required": ["term", "operator", "operation", "arguments"], "properties": {"term": {"const": "application"}, "operator": {"enum": ["call", "unary", "binary", "conditional", "let", "quantify", "collection", "query", "convert", "pre", "present", "value", "deref", "reaches", "temporal", "protocol_control", "state_transition", "claim"]}, "operation": {"$ref": "#/$defs/Operation"}, "arguments": {"type": "array", "items": {"$ref": "#/$defs/SemanticTerm"}}}, "additionalProperties": false},
    "ExpressionApplication": {"type": "object", "required": ["version", "semantic_type", "body"], "properties": {"version": {"const": "quire.expression-application-node/v1"}, "semantic_type": {"$ref": "#/$defs/NodeId"}, "body": {"$ref": "#/$defs/ApplicationTerm"}}, "additionalProperties": false},
    "EnumDeclaration": {"type": "object", "required": ["version", "owner", "qualified_declaration", "ordered", "members"], "properties": {"version": {"const": "quire.enum-declaration-node/v1"}, "owner": {"$ref": "#/$defs/Owner"}, "qualified_declaration": {"$ref": "#/$defs/QualifiedName"}, "ordered": {"type": "boolean"}, "members": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/Identifier"}}}, "additionalProperties": false},
    "EnumMember": {"type": "object", "required": ["version", "declaration_node_id", "case"], "properties": {"version": {"const": "quire.enum-member-node/v1"}, "declaration_node_id": {"$ref": "#/$defs/NodeId"}, "case": {"$ref": "#/$defs/Identifier"}}, "additionalProperties": false},
    "Dimension": {"type": "object", "required": ["version", "owner", "qualified_declaration", "terms"], "properties": {"version": {"const": "quire.dimension-node/v1"}, "owner": {"$ref": "#/$defs/Owner"}, "qualified_declaration": {"$ref": "#/$defs/QualifiedName"}, "terms": {"type": "array", "items": {"$ref": "#/$defs/DimensionTerm"}}}, "additionalProperties": false},
    "Unit": {"type": "object", "required": ["version", "owner", "qualified_declaration", "dimension_node_id", "target_unit_node_id", "scale", "offset"], "properties": {"version": {"const": "quire.unit-node/v1"}, "owner": {"$ref": "#/$defs/Owner"}, "qualified_declaration": {"$ref": "#/$defs/QualifiedName"}, "dimension_node_id": {"$ref": "#/$defs/NodeId"}, "target_unit_node_id": {"oneOf": [{"$ref": "#/$defs/NodeId"}, {"type": "null"}]}, "scale": {"$ref": "#/$defs/Rational"}, "offset": {"$ref": "#/$defs/Rational"}}, "additionalProperties": false}
  }
}
