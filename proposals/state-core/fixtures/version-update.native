// Synthetic operation; pre and post belong to one invocation.
language "ix:native" edition "0-draft";
profile "state-finite/0-draft";
model M = "example/config" version "1.0.0" digest "unresolved-model-package";
pre CanAttemptUpdate on M::ConfigVersion::attemptUpdate {
  self.versionNumber < 1000
}
post VersionUnchanged on M::ConfigVersion::attemptUpdate {
  self.versionNumber = pre(self.versionNumber)
}
